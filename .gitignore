# Environment / secrets — never commit real credentials.
.env

# Local environment variants (e.g. .env.local) — keep the committed template.
.env.*
!.env.example

# Python bytecode and cache.
__pycache__/
*.pyc

# Virtual environments.
.venv/

# Pytest and coverage artifacts.
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Default temporary clone directory used by the pipeline.
.auto-fixer-work/
