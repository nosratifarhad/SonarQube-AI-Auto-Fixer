# SonarQube AI Auto-Fixer - example configuration.
#
# Copy this file to `.env` and replace every placeholder. `.env` is ignored by
# Git; this example file is not, so NEVER put a real credential here.
#
# The default behaviour is read-only: commit, push and (future) PR creation are
# OFF unless you explicitly enable them below.

# ---------------------------------------------------------------------------
# SonarQube connection (required)
# ---------------------------------------------------------------------------
# Base URL of your SonarQube server (no trailing slash required).
SONAR_URL=https://sonar.example.com
# A user token with permission to read the project and its issues.
# The token is never printed, logged or committed.
SONAR_TOKEN=REPLACE_WITH_YOUR_SONAR_TOKEN
# The project key as it appears in SonarQube.
PROJECT_KEY=your-project-key

# ---------------------------------------------------------------------------
# Repository / Git (required)
# ---------------------------------------------------------------------------
# The repository to clone. Credentials embedded in the URL are redacted from
# every message the tool produces, but prefer a credential helper / SSH agent.
FIXER_REPOSITORY_URL=https://git.example.com/team/your-repo.git
# The branch SonarQube analysed; the isolated fix branch is created from it.
FIXER_SOURCE_BRANCH=main
# The repository's default branch. Required by the branch-protection policy:
# a missing value refuses every branch rather than guessing.
FIXER_DEFAULT_BRANCH=main
# Remote that a push (only with --push) targets. Default: origin.
FIXER_REMOTE_NAME=origin
# Destination branch for a push. Defaults to the generated agent branch.
# FIXER_DESTINATION_BRANCH=ai/sonar-fix/your-issue
# Local directory used for temporary clones. Created if it does not exist.
FIXER_WORK_DIR=.auto-fixer-work

# ---------------------------------------------------------------------------
# Project test command (required)
# ---------------------------------------------------------------------------
# Run inside the clone after the AI change. Prefer the JSON array form so an
# argument containing a space cannot be mis-split.
FIXER_TEST_COMMAND=["pytest", "-q"]
FIXER_TEST_TIMEOUT=600

# ---------------------------------------------------------------------------
# SonarQube re-analysis command (required)
# ---------------------------------------------------------------------------
# The analysis mechanism (for example the SonarScanner CLI). The scanner reads
# SONAR_HOST_URL / SONAR_TOKEN from the environment the tool injects; they are
# never placed on the command line.
FIXER_ANALYSIS_COMMAND=["sonar-scanner"]
FIXER_ANALYSIS_TIMEOUT=900
# How long to wait for the compute-engine task to finish, and how often to poll.
FIXER_ANALYSIS_WAIT_TIMEOUT=600
FIXER_ANALYSIS_POLL_INTERVAL=5
# Declare this ONLY when nothing else analyses this project during the run.
# The issue API cannot be filtered by analysis id, so an absence is only
# attributable to this run under this single-analysis precondition.
FIXER_EXCLUSIVE_ANALYSIS=false

# ---------------------------------------------------------------------------
# AI / Codex CLI (optional)
# ---------------------------------------------------------------------------
FIXER_CODEX_COMMAND=codex
FIXER_CODEX_ARGS=["exec"]
FIXER_CODEX_TIMEOUT=900

# ---------------------------------------------------------------------------
# Policy limits (required before a run; an unconfigured limit is refused)
# ---------------------------------------------------------------------------
# Maximum number of issues one run may process.
FIXER_MAX_ISSUES=1
# Maximum number of attempts one issue may receive.
FIXER_MAX_ITERATIONS=1

# ---------------------------------------------------------------------------
# Rule allowlist (optional; empty means no rule may be fixed automatically)
# ---------------------------------------------------------------------------
# Exact SonarQube rule IDs approved for an automatic fix, comma-separated.
# Matching is exact: no wildcards, no prefixes, no case folding.
FIXER_ALLOWED_RULES=python:S1481,python:S1192

# ---------------------------------------------------------------------------
# Branch protection (optional; defaults shown)
# ---------------------------------------------------------------------------
FIXER_PROTECTED_BRANCHES=main,master,develop,trunk
FIXER_REQUIRE_AI_BRANCH_PREFIX=true

# ---------------------------------------------------------------------------
# Irreversible steps (optional; defaults are safe)
# ---------------------------------------------------------------------------
# Enable a commit of a fully verified fix (T20).
FIXER_COMMIT_FIXES=false
# Enable a push of a verified commit (T21). Requires FIXER_COMMIT_FIXES.
FIXER_PUSH_FIXES=false
# Keep the temporary clone after a run (debugging only).
FIXER_KEEP_WORK_DIR=false
